# PostgreSQL connection string (required)
# Example: postgres://user:password@host:5432/school_marketplace
DATABASE_URL=

# Secret used to sign/hmac session tokens (required, use a long random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Admin account created by the seed script (optional)
# If unset, a development admin is created with a generated password printed to the console.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Max upload size per image in bytes (default 5242880 = 5MB)
MAX_IMAGE_SIZE=5242880
